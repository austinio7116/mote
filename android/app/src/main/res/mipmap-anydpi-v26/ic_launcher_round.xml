<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: two full-bleed layers the launcher masks to its own shape and
     parallaxes against each other. Without this the system pastes the legacy
     square bitmap onto a white plate, which is what made the icon look like a
     sticker. The monochrome layer is Android 13+ themed icons; older platforms
     ignore it. Layers are generated by android/tools/gen_icon.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
